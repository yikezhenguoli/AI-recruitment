# Node dependencies
**/node_modules/
**/dist/
**/.vite/

# Environment variables
.env
.env.*
!.env.example

# Python
.venv/
venv/
__pycache__/
*.py[cod]

# IDE
.idea/
.vscode/

# OS
.DS_Store
Thumbs.db

# Local dataset (unpacked archive, not for version control)
ANN/

# Local-only research data and tabular archives
/JDList
/JDList/
/RISMv1/
/RISMv2/
*.csv
*.zip

# resume-match：收录源码、JD、数据划分与合成训练数据；模型权重和大数据集不进仓库
resume-match/*
!resume-match/*.py
!resume-match/*.md
!resume-match/*.txt
!resume-match/*.sh
!resume-match/jd/
!resume-match/scripts/
!resume-match/splits/
!resume-match/splits/*.csv
resume-match/data/
resume-match/runs/
# synth：train_gbdt.py 默认读取的合成简历数据（无隐私、体积小），随仓库分发
!resume-match/synth/
!resume-match/synth/*.csv
# gbdt_model：GBDT 训练产出的模型（约 1 MB），随仓库分发
!resume-match/gbdt_model/
!resume-match/gbdt_model/*.csv
resume-match/synth_hard/
resume-match/gbdt/
resume-match/gbdt_hard/
resume-match/**/__pycache__/

# Local backend runtime data
apps/api/cache/
apps/api/uploads/

# 本地开发 HTTPS 证书（候选人端手机录音需要）
apps/candidate-web/.certs/
apps/candidate-web/public/ttc-dev-ca.crt

# 本地简历 HTML 与分析数据，不纳入版本控制
/resume-html/
/resume_html/

# 本地数据集，不纳入版本控制
/dataset/

# 本地默认账号密码，严禁提交
/passwd.md
