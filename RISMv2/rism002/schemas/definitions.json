{
  "version": "RISM-002.1",
  "description": "RISM-002 数据 Schema（draft-07 子集）。$defs 由 rism002/schemas/validator.py 解析。",

  "$defs": {
    "review": {
      "type": "object",
      "required": ["annotation_source", "annotation_status", "annotator_id", "reviewed_at", "review_reason", "ontology_version", "reviewed"],
      "properties": {
        "annotation_source": {"type": ["string", "null"], "enum": ["human", "historical_question", "rule_based", "llm", "unknown", null]},
        "annotation_status": {"type": "string", "enum": ["pending", "approved", "rejected"]},
        "annotator_id": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"]},
        "review_reason": {"type": "string"},
        "ontology_version": {"type": "string", "minLength": 1},
        "reviewed": {"type": "boolean"}
      }
    },
    "direction_annotation": {
      "type": "object",
      "required": ["direction_id", "label_status", "annotation_source", "reviewed"],
      "properties": {
        "direction_id": {"type": "string", "minLength": 1},
        "label_status": {"type": "string", "enum": ["positive", "negative", "unknown"]},
        "annotation_source": {"type": ["string", "null"], "enum": ["human", "historical_question", "rule_based", "llm", "unknown", null]},
        "reviewed": {"type": "boolean"},
        "review_reason": {"type": "string"},
        "ontology_version": {"type": "string"}
      }
    },
    "strategy": {
      "type": "object",
      "required": ["strategy_id", "experience_id", "dimension", "direction_id", "direction_name", "trigger_claim_ids", "trigger_gap_ids", "rationale", "investigation_goal", "evidence_to_obtain", "risk_signals", "expected_answer_signals", "follow_up_triggers", "strategy_type", "priority", "difficulty", "sequence", "prerequisites", "label_status", "review"],
      "properties": {
        "strategy_id": {"type": "string", "minLength": 1},
        "experience_id": {"type": "string", "minLength": 1},
        "dimension": {"type": "string", "enum": ["achievement_verification", "business_understanding", "data_evidence", "innovation", "leadership", "learning_ability", "personal_contribution", "problem_solving", "professional_depth", "project_management", "reflection", "risk_awareness", "teamwork", "technical_decision", "technical_implementation"]},
        "direction_id": {"type": "string", "minLength": 1},
        "direction_name": {"type": "string", "minLength": 1},
        "trigger_claim_ids": {"type": "array", "items": {"type": "string"}},
        "trigger_gap_ids": {"type": "array", "items": {"type": "string"}},
        "rationale": {"type": "string", "minLength": 1},
        "investigation_goal": {"type": "string", "minLength": 1},
        "evidence_to_obtain": {"type": "array", "items": {"type": "string"}},
        "risk_signals": {"type": "array", "items": {"type": "string"}},
        "expected_answer_signals": {"type": "array", "items": {"type": "string"}},
        "follow_up_triggers": {"type": "array", "items": {"type": "string"}},
        "strategy_type": {"type": "string", "enum": ["process_reconstruction", "principle_verification", "decision_verification", "evidence_verification", "contribution_verification", "scenario_extension", "counterfactual_analysis", "reflection_analysis"]},
        "priority": {"type": "string", "enum": ["high", "medium", "low"]},
        "difficulty": {"type": "string", "enum": ["L1", "L2", "L3", "L4"]},
        "sequence": {"type": "integer"},
        "prerequisites": {"type": "array", "items": {"type": "string"}},
        "label_status": {"type": "string", "enum": ["positive", "negative", "unknown"]},
        "review": {"$ref": "#/$defs/review"}
      }
    }
  },

  "schemas": {
    "claim": {
      "type": "object",
      "required": ["claim_id", "experience_id", "resume_id", "claim_type", "claim_text", "source_text", "review"],
      "properties": {
        "claim_id": {"type": "string", "minLength": 1},
        "experience_id": {"type": "string", "minLength": 1},
        "resume_id": {"type": "string", "minLength": 1},
        "claim_type": {"type": "string", "enum": ["responsibility", "technical_method", "decision", "quantified_achievement", "qualitative_achievement", "leadership", "collaboration", "innovation", "problem_resolution"]},
        "claim_text": {"type": "string", "minLength": 1},
        "source_text": {"type": "string", "minLength": 1},
        "source_span": {"type": ["object", "null"]},
        "confidence": {"type": "number"},
        "review": {"$ref": "#/$defs/review"}
      }
    },

    "evidence_gap": {
      "type": "object",
      "required": ["gap_id", "experience_id", "resume_id", "related_claim_ids", "gap_type", "description", "review"],
      "properties": {
        "gap_id": {"type": "string", "minLength": 1},
        "experience_id": {"type": "string", "minLength": 1},
        "resume_id": {"type": "string", "minLength": 1},
        "related_claim_ids": {"type": "array", "items": {"type": "string"}},
        "gap_type": {"type": "string", "enum": ["missing_process", "missing_technical_details", "missing_decision_basis", "missing_measurement_method", "missing_baseline", "missing_attribution", "missing_business_impact", "missing_risk_handling", "missing_result_validation"]},
        "description": {"type": "string", "minLength": 1},
        "source_text": {"type": ["string", "null"]},
        "source_span": {"type": ["object", "null"]},
        "review": {"$ref": "#/$defs/review"}
      }
    },

    "direction": {
      "type": "object",
      "required": ["direction_id", "direction_name", "parent_dimensions", "definition", "inclusion_criteria", "exclusion_criteria", "evidence_types", "typical_trigger_claims", "related_directions", "applicable_position_families", "status", "version", "review"],
      "properties": {
        "direction_id": {"type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9_]*$"},
        "direction_name": {"type": "string", "minLength": 1},
        "parent_dimensions": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "enum": ["achievement_verification", "business_understanding", "data_evidence", "innovation", "leadership", "learning_ability", "personal_contribution", "problem_solving", "professional_depth", "project_management", "reflection", "risk_awareness", "teamwork", "technical_decision", "technical_implementation"]}
        },
        "definition": {"type": "string", "minLength": 8},
        "inclusion_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "exclusion_criteria": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "evidence_types": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "typical_trigger_claims": {"type": "array", "items": {"type": "string"}},
        "related_directions": {"type": "array", "items": {"type": "string"}},
        "applicable_position_families": {"type": "array", "items": {"type": "string"}},
        "status": {"type": "string", "enum": ["candidate", "approved", "deprecated"]},
        "version": {"type": "string", "minLength": 1},
        "origin": {"type": "object"},
        "review": {"$ref": "#/$defs/review"}
      }
    },

    "competency": {
      "type": "object",
      "required": ["position_family", "competency_id", "competency_name", "competency_definition", "importance", "related_direction_ids"],
      "properties": {
        "position_family": {"type": "string", "minLength": 1},
        "competency_id": {"type": "string", "minLength": 1},
        "competency_name": {"type": "string", "minLength": 1},
        "competency_definition": {"type": "string", "minLength": 8},
        "importance": {"type": "string", "enum": ["high", "medium", "low"]},
        "related_direction_ids": {"type": "array", "items": {"type": "string"}},
        "version": {"type": "string"},
        "review": {"$ref": "#/$defs/review"}
      }
    },

    "strategy": {"$ref": "#/$defs/strategy"},

    "sample": {
      "type": "object",
      "required": ["sample_id", "resume_id", "candidate_id", "experience", "job", "key_claims", "evidence_gaps", "investigation_strategies", "direction_annotations", "annotation"],
      "properties": {
        "sample_id": {"type": "string", "minLength": 1},
        "resume_id": {"type": "string", "minLength": 1},
        "candidate_id": {"type": "string", "minLength": 1},
        "experience": {
          "type": "object",
          "required": ["experience_id", "experience_type", "title", "experience_text"],
          "properties": {
            "experience_id": {"type": "string", "minLength": 1},
            "experience_type": {"type": "string", "enum": ["education", "internship", "work_experience", "project_experience", "achievement", "skill_application", "research", "competition"]},
            "title": {"type": "string"},
            "experience_text": {"type": "string", "minLength": 1}
          }
        },
        "job": {
          "type": "object",
          "required": ["target_position", "position_family", "career_level", "job_requirements"],
          "properties": {
            "target_position": {"type": "string", "minLength": 1},
            "position_family": {"type": "string", "minLength": 1},
            "career_level": {"type": "string", "enum": ["fresh", "junior", "mid", "senior", "expert"]},
            "job_requirements": {"type": "array", "items": {"type": "string"}}
          }
        },
        "key_claims": {"type": "array", "items": {"$ref": "#/schemas/claim"}},
        "evidence_gaps": {"type": "array", "items": {"$ref": "#/schemas/evidence_gap"}},
        "investigation_strategies": {"type": "array", "items": {"$ref": "#/$defs/strategy"}},
        "direction_annotations": {"type": "array", "items": {"$ref": "#/$defs/direction_annotation"}},
        "annotation": {
          "type": "object",
          "required": ["annotation_source", "annotation_status", "reviewed", "ontology_version"],
          "properties": {
            "annotation_source": {"type": "string", "enum": ["human", "historical_question", "rule_based", "llm", "unknown"]},
            "annotation_status": {"type": "string", "enum": ["pending", "approved", "rejected", "reviewed"]},
            "annotator_id": {"type": ["string", "null"]},
            "reviewed": {"type": "boolean"},
            "reviewed_at": {"type": ["string", "null"]},
            "ontology_version": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
