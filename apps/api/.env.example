APP_ENV=development
API_PREFIX=/api/v1
POSTGRES_DB=ttc
POSTGRES_USER=ttc
POSTGRES_PASSWORD=change-me-local
DATABASE_URL=postgresql+asyncpg://ttc:change-me-local@127.0.0.1:5432/ttc
LOG_LEVEL=INFO
JWT_SECRET=
COLUMN_ENCRYPTION_KEY=
DEMO_MODE=false
OPENATS_BASE_URL=
OPENATS_API_KEY=
VEKT_BASE_URL=
VEKT_API_KEY=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_RESUMES=resumes
S3_BUCKET_AUDIO=audio
# DeepSeek（OpenAI 兼容）：JD 生成/抽取、简历 claims、匹配解释
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60
# 简历-岗位匹配小模型：通过子进程调用 resume-match/infer_cli.py
RESUME_MATCH_MODEL_DIR=
RESUME_MATCH_PYTHON=python3
RESUME_MATCH_TIMEOUT_SECONDS=120
RESUME_MATCH_ALLOW_KEYWORD_FALLBACK=false
# OpenAI Realtime（SDP 服务端代理；与 Qwen 中转二选一）
REALTIME_API_KEY=
REALTIME_MODEL=
# 通义千问 Realtime（DashScope WebSocket，后端中转）
DASHSCOPE_API_KEY=
DASHSCOPE_REALTIME_MODEL=qwen3-omni-flash-realtime
DASHSCOPE_REALTIME_VOICE=Cherry
DASHSCOPE_REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime
