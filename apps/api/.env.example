# ─── LLM provider: DeepSeek (OpenAI-compatible) ───────────────────────────────
# Docs: https://api-docs.deepseek.com/zh-cn/
# Copy this file to .env and fill in the real key. Never commit .env.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Optional higher-quality model (switch by changing DEEPSEEK_MODEL):
# DEEPSEEK_MODEL=deepseek-v4-pro

# ─── Pipeline ──────────────────────────────────────────────────────────────────
MAX_CONCURRENCY=5
MAX_LLM_RETRIES=3
LLM_RETRY_MIN_WAIT=1
LLM_RETRY_MAX_WAIT=10
LLM_TIMEOUT_SECONDS=120

# ─── Storage ───────────────────────────────────────────────────────────────────
CACHE_DIR=./cache
UPLOAD_DIR=./uploads
SAVED_JOBS_FILE=./cache/saved_jobs.json

# ─── App ───────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Qwen Realtime voice provider ─────────────────────────────────────────────
# Endpoint/model pending backend owner confirmation. Do not put a real key here.
QWEN_REALTIME_API_KEY=
QWEN_REALTIME_BASE_URL=
QWEN_REALTIME_MODEL=
